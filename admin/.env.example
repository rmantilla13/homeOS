# Supabase project (Dashboard → Project Settings → API). The anon key is the
# public client key; this app never uses the service role key.
# NEXT_PUBLIC_SUPABASE_URL is also the issuer that POST /api/assistant-identity
# trusts when the assistant asks for a Vercel OIDC token. That route does not
# take an Anthropic API key. See docs/PLATFORM.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo mode: fixture data, no sign-in, never talks to Supabase. Only the exact
# value 1 turns it on. Leave it unset everywhere real admins sign in.
# NEXT_PUBLIC_ADMIN_DEMO=1

# Private Vercel Blob store for family photos and videos (avatars stay in Supabase).
# On Vercel, connecting the store sets BLOB_STORE_ID and the runtime provides
# VERCEL_OIDC_TOKEN. Locally, `vercel env pull` also writes the read-write token.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Server-made wall copies of videos (docs/ADMIN.md → "Big videos"). Off until
# MEDIA_JOBS_SECRET is set. It must be the same value as the media-jobs edge
# function's secret (supabase secrets set MEDIA_JOBS_SECRET=...) and at least
# 32 characters: openssl rand -hex 32. Jobs run in Vercel Sandbox with the
# project's OIDC token; no other key is needed.
# MEDIA_JOBS_SECRET=
# Vercel Cron sends this to /api/media/process/sweep: openssl rand -hex 32.
# CRON_SECRET=
# Optional. Where sandboxes report back; defaults to the production domain.
# MEDIA_CALLBACK_ORIGIN=https://ohanaos.co
# Optional. vCPUs per sandbox (1, 2, 4, 6 or 8; default 8).
# MEDIA_SANDBOX_VCPUS=8
# Optional. A static Linux ffmpeg (tar.xz with ffmpeg and ffprobe) for
# sandboxes whose image has none, and its sha256.
# MEDIA_FFMPEG_URL=
# MEDIA_FFMPEG_SHA256=
