// Copy to Local.xcconfig (that file stays uncommitted). A key set here wins
// over ios/Config/Defaults.xcconfig. xcconfig treats // as a comment, so write
// a URL's scheme as https:/$()/

// Required for a device run or a TestFlight archive.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Optional. The defaults are team 92X9CP6C6D and com.ohanaos.ohana. The bundle
// id must match the app record in App Store Connect.
// OHANAOS_TEAM_ID = 92X9CP6C6D
// OHANAOS_BUNDLE_ID = com.ohanaos.ohana

// Optional. Photos and videos upload through https://ohanaos.co by default.
// Set this only to test another admin deployment (origin only, no path).
// A placeholder left here would replace the default.
// MEDIA_API_URL = https:/$()/homeos-admin.vercel.app
