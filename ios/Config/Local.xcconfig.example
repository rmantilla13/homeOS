// Copy to Local.xcconfig (that file stays uncommitted).
// Team 92X9CP6C6D is already the default. Set this only to use another team.
OHANAOS_TEAM_ID = 92X9CP6C6D

// Register this identifier under Certificates, Identifiers & Profiles, then
// pick the same one when you create the Ohana app in App Store Connect.
OHANAOS_BUNDLE_ID = com.ohanaos.ohana

// xcconfig treats // as a comment. Write the scheme as https:/$()/
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
MEDIA_API_URL = https:/$()/your-admin-app.vercel.app
