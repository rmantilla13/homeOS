# Runs the wall display as a kiosk on boot, straight to the panel via EGLFS.
# Install: sudo cp homeos-display.service /etc/systemd/system/ && sudo systemctl enable --now homeos-display
[Unit]
Description=homeOS wall display
After=network-online.target systemd-user-sessions.service
Wants=network-online.target

[Service]
User=homeos
SupplementaryGroups=video input render
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_IM_MODULE=qtvirtualkeyboard
# Backend settings live in ~homeos/.config/homeOS/display.conf (written after pairing),
# or set HOMEOS_SUPABASE_URL / HOMEOS_SUPABASE_ANON_KEY here.
EnvironmentFile=-/etc/homeos/display.env
ExecStart=/usr/local/bin/homeos-display
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
