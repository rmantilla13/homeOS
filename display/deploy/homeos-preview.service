# Shows homeOS on a virtual screen you open in a web browser, for using the Pi
# before the panel is connected. Installed by display/deploy/preview.sh (which
# fills in @USER@); it replaces the kiosk service while it runs.
[Unit]
Description=homeOS preview (virtual screen in a browser)
After=network-online.target homeos-bootscreen.service
Wants=network-online.target
Conflicts=homeos-display.service

[Service]
User=@USER@
# The same settings as the kiosk, plus HOMEOS_PREVIEW_LAN from preview.env.
EnvironmentFile=-/etc/homeos/preview.env
# Same handoff as the kiosk: drop the boot video before drawing.
ExecStartPre=-+/usr/local/libexec/homeos-stop-bootscreen
ExecStart=/usr/local/bin/homeos-preview
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
