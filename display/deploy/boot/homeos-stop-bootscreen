#!/usr/bin/env bash
# Stop the boot video and wait until it has exited.
#
# homeos-display runs this before it opens HDMI. It must not call
# `systemctl stop`: that queues a job, and during boot the job cannot run
# until this service finishes starting, so the two wait on each other.
set +e

pid="${HOMEOS_BOOTSCREEN_PID:-}"
if [ -z "$pid" ] && command -v systemctl >/dev/null 2>&1; then
    pid=$(systemctl show -p MainPID --value homeos-bootscreen.service 2>/dev/null)
fi
if [ -z "$pid" ] || [ "$pid" = "0" ]; then
    exit 0
fi
case "$pid" in
    ''|*[!0-9]*) exit 0 ;;
esac

signal_tree() {
    local sig="$1" p="$2" child
    for child in $(ps -o pid= --ppid "$p" 2>/dev/null); do
        signal_tree "$sig" "$child"
    done
    kill -s "$sig" "$p" 2>/dev/null
}

signal_tree TERM "$pid"
i=0
while [ "$i" -lt 12 ]; do
    kill -0 "$pid" 2>/dev/null || exit 0
    sleep 0.25
    i=$((i + 1))
done
signal_tree KILL "$pid"
sleep 0.2
exit 0
