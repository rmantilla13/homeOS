# Downloads the boot video set in the admin console to /var/lib/homeos/boot.mp4,
# where homeos-bootscreen plays it from the next boot. Started by
# homeos-boot-video-sync.timer after the network is up, so the boot itself
# never waits on Wi-Fi. Installed by install-pi.sh.
[Unit]
Description=Ohana boot video download
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/homeos-bootscreen --sync
# A background download: stay out of the app's way. It gives up on its own
# when the transfer stalls (see homeos-bootscreen).
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
